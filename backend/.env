# Conexion Local a SQL Server (EcoRAEE_DB)
# En AWS RDS cambiar por:
# DATABASE_URL=mssql+pyodbc://admin:TU_PASSWORD@tu-rds-endpoint.us-east-1.rds.amazonaws.com:1433/EcoRAEE_DB?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DATABASE_URL=mssql+pyodbc://@localhost/EcoRAEE_DB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# CORS permitidos (en AWS agrega la URL de tu bucket S3 / CloudFront / dominio)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# En local USE_LOCAL_STORAGE=true guarda evidencias en backend/uploads
# En AWS EC2 cambiar a false para usar el bucket S3
USE_LOCAL_STORAGE=true
BACKEND_BASE_URL=http://localhost:8000

# Credenciales AWS S3 (dejar vacias en EC2 si usas IAM Role; completar si usas Access Keys / AWS Academy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_BUCKET_EVIDENCIAS=ecoraee-cloud-evidencias
S3_PREFIX=evidencias
S3_PUBLIC_BASE_URL=
S3_USE_PRESIGNED_URLS=false
S3_PRESIGNED_EXPIRATION=86400
