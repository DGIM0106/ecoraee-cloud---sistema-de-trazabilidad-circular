# Conexion Local a SQL Server (EcoRAEE_DB)
# En AWS RDS cambiar por: mssql+pyodbc://admin:password@rds-endpoint:1433/EcoRAEE_DB?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://@localhost/EcoRAEE_DB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# En esta etapa local USE_LOCAL_STORAGE=true guarda evidencias en backend/uploads
# En el despliegue AWS se cambia a false para usar el bucket S3
USE_LOCAL_STORAGE=true
BACKEND_BASE_URL=http://localhost:8000

# Credenciales AWS S3 (preparado para futura implementacion Cloud)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_EVIDENCIAS=ecoraee-cloud-evidencias

